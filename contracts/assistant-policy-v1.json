{
  "contractId": "insight.assistant-policy",
  "schemaVersion": "1.1.0",
  "status": "accepted",
  "scope": "INS-055",
  "supersedes": "INS-006 disabled assistant decision",
  "assistant": {
    "v1Scope": "approved-read-only-treatment-plan-review",
    "enabled": true,
    "provider": "deployment-configured-advisory-provider",
    "unsupportedOrIncompletePolicyResult": "disabled"
  },
  "providerBoundary": {
    "transmissionAllowed": true,
    "structuralIdentifierOmissionRequiredBeforeScrubbing": true,
    "defenseInDepthScrubbingRequired": true,
    "forbiddenIdentifierClasses": [
      "patient-name",
      "patient-code",
      "medical-record-number",
      "phone-number",
      "email-address",
      "postal-address",
      "date"
    ]
  },
  "pageContext": {
    "allowlist": [
      "treatment-plan-review.plan.content.setting",
      "treatment-plan-review.plan.content.pharmacotherapy.medicationCode",
      "treatment-plan-review.plan.content.pharmacotherapy.codeSystem",
      "treatment-plan-review.plan.content.pharmacotherapy.dose",
      "treatment-plan-review.plan.content.pharmacotherapy.route",
      "treatment-plan-review.plan.content.pharmacotherapy.frequency",
      "treatment-plan-review.plan.content.nextAppointment.interval",
      "treatment-plan-review.plan.content.nextAppointment.timezone",
      "treatment-plan-review.plan.safetyFindings.category",
      "treatment-plan-review.plan.safetyFindings.severity",
      "treatment-plan-review.plan.safetyFindings.status",
      "treatment-plan-review.plan.safetyFindings.summary",
      "treatment-plan-review.rationale"
    ],
    "default": "deny"
  },
  "tools": {
    "allowlist": [],
    "default": "deny",
    "forbiddenCapabilities": [
      "create",
      "update",
      "delete",
      "submit",
      "sign",
      "approve",
      "finalize"
    ]
  },
  "conversation": {
    "persistenceEnabled": false,
    "retention": "none-no-storage",
    "authorizedRoles": ["psychiatrist"],
    "deletion": "not-applicable-no-storage",
    "includedInBackup": false
  },
  "providerUsePolicy": {
    "approved": true,
    "promptsOrOutputsMayBeRetainedByProvider": false,
    "promptsOrOutputsMayBeUsedForTraining": false
  },
  "ui": {
    "state": "bounded-read-only-rail",
    "message": "Advisory assistant. Psychiatrist review required.",
    "promptControlVisible": true,
    "mutationControlsVisible": false
  },
  "failurePolicy": {
    "clinicalWorkflowBlocking": false,
    "clinicalWorkflowMutationAllowed": false,
    "fallback": "provider-unavailable-ui-state"
  },
  "syntheticRedactionCorpus": [
    {"class": "patient-name", "input": "Test Patient", "expected": "[REDACTED]"},
    {"class": "patient-code", "input": "PT-000001", "expected": "[REDACTED]"},
    {"class": "medical-record-number", "input": "MRN-000001", "expected": "[REDACTED]"},
    {"class": "phone-number", "input": "+1-202-555-0100", "expected": "[REDACTED]"},
    {"class": "email-address", "input": "patient@example.invalid", "expected": "[REDACTED]"},
    {"class": "postal-address", "input": "1 Example Street", "expected": "[REDACTED]"},
    {"class": "date", "input": "2000-01-01", "expected": "[REDACTED]"}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight.capability-matrix-v1.schema.json",
  "title": "INSIGHT v1 capability traceability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "schemaVersion", "scope", "status", "source", "releaseModes", "rows", "completionContract"],
  "properties": {
    "contractId": {"const": "insight.capability-matrix"},
    "schemaVersion": {"const": "1.0.0"},
    "scope": {"const": "INS-066"},
    "status": {"const": "frozen"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "context/project-overview.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "releaseModes": {
      "type": "array",
      "prefixItems": [{"const": "research-build"}, {"const": "controlled-clinical"}],
      "items": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "completionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRowRule", "conditionalRowRule", "technicalCompletionRule", "clinicalReleaseRule", "missingEvidenceRule"],
      "properties": {
        "requiredRowRule": {"type": "string", "minLength": 1},
        "conditionalRowRule": {"type": "string", "minLength": 1},
        "technicalCompletionRule": {"type": "string", "minLength": 1},
        "clinicalReleaseRule": {"type": "string", "minLength": 1},
        "missingEvidenceRule": {"const": "blocked"}
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRef", "capability", "requirement", "implementationIssues", "contractSchemas", "releaseApplicability"],
      "properties": {
        "id": {"type": "string", "pattern": "^CAP-[0-9]{3}$"},
        "sourceRef": {"type": "string", "pattern": "^(goal|core-flow|feature-[a-z-]+|in-scope|out-of-scope|success)-[0-9]+[a-z]?$"},
        "capability": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "conditional"]},
        "implementationIssues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^INS-[0-9]{3}$"}
        },
        "contractSchemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "releaseApplicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["research-build", "controlled-clinical"],
          "properties": {
            "research-build": {"enum": ["required", "conditional", "not-applicable"]},
            "controlled-clinical": {"enum": ["required", "conditional", "not-applicable"]}
          }
        }
      }
    }
  }
}

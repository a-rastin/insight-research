{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight.knowledge-source-manifest-v1.schema.json",
  "title": "INSIGHT knowledge source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "schemaVersion", "scope", "status", "profile", "authorityPolicy", "sources", "requiredProvenance", "updateCadence", "observableBlockedCase", "releaseGate"],
  "properties": {
    "contractId": {"const": "insight.knowledge-source-manifest"},
    "schemaVersion": {"const": "1.0.0"},
    "scope": {"const": "INS-009"},
    "status": {"const": "accepted"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "releaseUse", "clinicalDeploymentAllowed"],
      "properties": {
        "jurisdiction": {"const": "US"},
        "releaseUse": {"const": "research-only"},
        "clinicalDeploymentAllowed": {"const": false}
      }
    },
    "authorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUpdatesAutoActivate", "preserveOriginalClinicianValues", "unresolvedTermsRemainVisible", "missingOrStaleSourceBehavior", "historicalResultsRetainPinnedSources"],
      "properties": {
        "sourceUpdatesAutoActivate": {"const": false},
        "preserveOriginalClinicianValues": {"const": true},
        "unresolvedTermsRemainVisible": {"const": true},
        "missingOrStaleSourceBehavior": {"const": "block-affected-output"},
        "historicalResultsRetainPinnedSources": {"const": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"},
      "allOf": [
        {"contains": {"properties": {"domain": {"const": "formulary"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"domain": {"const": "medication-dosing"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"domain": {"const": "medication-contraindications"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"domain": {"const": "medication-monitoring"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"domain": {"const": "diagnosis-terminology"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"domain": {"const": "medication-terminology"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "requiredProvenance": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["authority-domain", "authority-name", "source-version", "source-record-identifier", "source-document-date", "source-url", "retrieved-at", "source-sha256"]}
    },
    "updateCadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drugsAtFda", "rxNorm", "icd10cm", "governanceReviewIntervalDays", "changeRequiresValidation", "changeRequiresClinicalReview", "overdueBehavior"],
      "properties": {
        "drugsAtFda": {"$ref": "#/$defs/cadence"},
        "rxNorm": {"$ref": "#/$defs/cadence"},
        "icd10cm": {"$ref": "#/$defs/cadence"},
        "governanceReviewIntervalDays": {"type": "integer", "minimum": 1},
        "changeRequiresValidation": {"const": true},
        "changeRequiresClinicalReview": {"const": true},
        "overdueBehavior": {"const": "block-affected-output"}
      }
    },
    "observableBlockedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "code", "includeFailedDomains", "includeSourceVersion", "includeResolutionActions", "authoritativeClinicalClaimAllowed"],
      "properties": {
        "state": {"const": "knowledge-authority-blocked"},
        "code": {"const": "KNOWLEDGE_AUTHORITY_UNAVAILABLE"},
        "includeFailedDomains": {"const": true},
        "includeSourceVersion": {"const": true},
        "includeResolutionActions": {"const": true},
        "authoritativeClinicalClaimAllowed": {"const": false}
      }
    },
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockedBy"],
      "properties": {
        "state": {"const": "blocked"},
        "blockedBy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "authorityStatus", "authorityName", "publisher", "sourceUrl", "pinnedVersion", "licenseStatus", "allowedResearchUse", "decision"],
      "properties": {
        "domain": {"enum": ["formulary", "medication-dosing", "medication-contraindications", "medication-monitoring", "diagnosis-terminology", "medication-terminology"]},
        "authorityStatus": {"enum": ["selected", "not-applicable"]},
        "authorityName": {"type": ["string", "null"], "minLength": 1},
        "publisher": {"type": ["string", "null"], "minLength": 1},
        "sourceUrl": {"type": ["string", "null"], "format": "uri"},
        "pinnedVersion": {"type": ["string", "null"], "minLength": 1},
        "licenseStatus": {"enum": ["public-us-government-source", "no-license-required-release", "not-applicable"]},
        "allowedResearchUse": {"type": "boolean"},
        "decision": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"authorityStatus": {"const": "selected"}}},
      "then": {
        "properties": {
          "authorityName": {"type": "string"},
          "publisher": {"type": "string"},
          "sourceUrl": {"type": "string"},
          "pinnedVersion": {"type": "string"},
          "allowedResearchUse": {"const": true}
        }
      },
      "else": {
        "properties": {
          "authorityName": {"const": null},
          "publisher": {"const": null},
          "sourceUrl": {"const": null},
          "pinnedVersion": {"const": null},
          "licenseStatus": {"const": "not-applicable"},
          "allowedResearchUse": {"const": false}
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkSchedule", "maximumUncheckedDays"],
      "properties": {
        "checkSchedule": {"enum": ["weekdays", "weekly", "every-30-days"]},
        "maximumUncheckedDays": {"type": "integer", "minimum": 1}
      }
    }
  }
}

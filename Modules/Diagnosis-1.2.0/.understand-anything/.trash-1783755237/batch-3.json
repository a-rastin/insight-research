      "complexity": "moderate",
      "summary": "SQLite-backed repository adapter. DiagnosisStore wraps sessions (code PK, patient_id, checked JSON, decision) and audit (id, code, snapshot JSON, created_at) tables. WAL journal, thread-safe via process lock. Methods: init, exists, get, put, audit_snapshot, list_audits, reset.",
      "tags": [
        "persistence",
        "sqlite",
        "repository",
        "wal-journal"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },

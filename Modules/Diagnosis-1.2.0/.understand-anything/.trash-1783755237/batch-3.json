      "name": "diagnosis/auth.py",
      "filePath": "diagnosis/auth.py",
      "language": "python",
      "complexity": "moderate",
      "summary": "Auth adapter delegating trust to the central Insight auth service. Calls GET {AUTH_BASE_URL}/api/auth/session with the Cookie header and reads the JSON response (authenticated, user_id, roles, session_id). Never decodes JWTs or reads the auth DB.",
      "tags": [
        "auth-delegation",
        "session",
        "role-enforcement",
        "insight-service"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },
    {
      "id": "file:diagnosis/csrf.py",
      "type": "file",
      "name": "diagnosis/csrf.py",
      "filePath": "diagnosis/csrf.py",
      "language": "python",
      "complexity": "moderate",
      "summary": "Signed double-submit CSRF token (HMAC-SHA256). mint() creates a fresh token set as cookie plus JSON body. require_csrf FastAPI dependency fails closed on any cookie/header mismatch or invalid signature. Pinned secret via DIAGNOSIS_CSRF_SECRET; per-process random fallback.",
      "tags": [
        "csrf",
        "hmac-sha256",
        "double-submit",
        "owasp"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },

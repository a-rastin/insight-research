      "language": "python",
      "complexity": "simple",
      "summary": "Browser page seam. GET / serves static/index.html and stamps a fresh signed CSRF token into meta name='csrf-token' plus the csrf cookie. Auth-gated (psychiatrist or admin). Under bypass shim the injection is skipped for byte-clean test asserts.",
      "tags": [
        "browser-page",
        "spa",
        "csrf-stamp",
        "auth-gated"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },
    {
      "id": "file:diagnosis/dashboard.py",
      "type": "file",
      "name": "diagnosis/dashboard.py",
      "filePath": "diagnosis/dashboard.py",
      "language": "python",
      "complexity": "moderate",
      "summary": "Dashboard discovery seam. Serves GET /diagnosis/_meta (criteria tree + meta_contract), GET /diagnosis/_csrf (mint token), GET /internal/dashboard/module-routes/{moduleId} (launch descriptor), and GET /internal/diagnosis/audit/{code} (audit trail). Read-only, auth-gated.",
      "tags": [
        "dashboard-discovery",
        "module-routes",
        "audit",
        "discovery-seam"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },
    {
      "id": "file:diagnosis/diagnosis_api.py",
      "type": "file",
      "name": "diagnosis/diagnosis_api.py",
      "filePath": "diagnosis/diagnosis_api.py",
      "language": "python",
      "complexity": "moderate",
      "summary": "Protected per-patient REST seam. POST /diagnosis/{code}/init (create session), GET /diagnosis/{code} (get session + evaluation), PUT /diagnosis/{code} (persist checked + decision, call audit hook). Writes require psychiatrist plus CSRF; reads accept psychiatrist or admin.",
      "tags": [
        "rest-seam",
        "diagnosis-api",
        "write-protected",
        "per-patient"
      ],
      "fileCategory": "code",
      "languageNotes": ""
    },
    {
      "id": "endpoint:diagnosis/dashboard.py:GET /diagnosis/_meta",
      "type": "endpoint",
      "name": "GET /diagnosis/_meta",
      "filePath": "diagnosis/dashboard.py",
      "complexity": "simple",
      "summary": "Returns {criteria, rules}. criteria is the DSM-5-TR tree; rules is the meta_contract driving the UI optimistic display. No patient data.",
      "tags": [
        "get-endpoint",
        "criteria-tree",
        "rules-contract"
      ],
      "languageNotes": ""
    },
    {
      "id": "endpoint:diagnosis/dashboard.py:GET /diagnosis/_csrf",
      "type": "endpoint",
      "name": "GET /diagnosis/_csrf",
      "filePath": "diagnosis/dashboard.py",
      "complexity": "simple",
      "summary": "Mints a signed CSRF token, sets the csrf cookie, returns {token}. Read-only.",
      "tags": [
        "get-endpoint",
        "csrf",
        "token-mint"
      ],
      "languageNotes": ""
    },
    {
      "id": "endpoint:diagnosis/dashboard.py:GET /internal/dashboard/module-routes/{moduleId}",
      "type": "endpoint",
      "name": "GET /internal/dashboard/module-routes/{moduleId}",
      "filePath": "diagnosis/dashboard.py",
      "complexity": "simple",
      "summary": "Dashboard module-route discovery. Returns {moduleId, title, description, launch: {href}, routes: {self, csrf, session}} for moduleId==diagnosis, 404 otherwise.",
      "tags": [
        "get-endpoint",
        "dashboard-discovery",
        "module-routes"
      ],
      "languageNotes": ""
    },
    {
      "id": "endpoint:diagnosis/dashboard.py:GET /internal/diagnosis/audit/{code}",
      "type": "endpoint",
      "name": "GET /internal/diagnosis/audit/{code}",
      "filePath": "diagnosis/dashboard.py",
      "complexity": "simple",
      "summary": "Audit-log seam. Returns {code, snapshots: [...]} with the chronological persisted audit trail. Unknown code returns empty snapshots list, not 404.",
      "tags": [
        "get-endpoint",
        "audit",
        "read-only"
      ],
      "languageNotes": ""
    },
    {
      "id": "endpoint:diagnosis/diagnosis_api.py:POST /diagnosis/{code}/init",
      "type": "endpoint",
      "name": "POST /diagnosis/{code}/init",
      "filePath": "diagnosis/diagnosis_api.py",
      "complexity": "simple",
      "summary": "Create an empty session for a patient code. Resolves patient identity (canonical id), calls store.init, returns {created, patient_id}. CSRF plus psychiatrist required.",
      "tags": [
        "post-endpoint",
        "session-init",
        "csrf-gated",
        "psychiatrist-required"
      ],
      "languageNotes": ""
    },
    {

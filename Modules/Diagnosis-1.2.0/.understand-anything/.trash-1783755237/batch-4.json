      "name": "GET /diagnosis/{code}",
      "filePath": "diagnosis/diagnosis_api.py",
      "complexity": "simple",
      "summary": "Return session state plus live evaluation for a patient code. 404 if never seen. No patient data mutation.",
      "tags": [
        "get-endpoint",
        "session-get",
        "evaluation"
      ],
      "languageNotes": ""
    },
    {

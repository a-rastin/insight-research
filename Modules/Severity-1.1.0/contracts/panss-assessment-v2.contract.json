{
  "moduleId": "severity",
  "interfaceVersion": "2.0.0",
  "schemaVersion": "2.0.0",
  "assessmentType": "PANSS",
  "scaleVersion": "PANSS-30-1.0.0",
  "ruleVersion": "PANSS-SUM-2.0.0",
  "items": {
    "positive": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"],
    "negative": ["N1", "N2", "N3", "N4", "N5", "N6", "N7"],
    "general": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9", "G10", "G11", "G12", "G13", "G14", "G15", "G16"]
  },
  "allowedItemScore": {
    "type": "integer",
    "minimum": 1,
    "maximum": 7
  },
  "statuses": {
    "in-progress": "Zero to 29 valid item ratings are present; no derived score is published.",
    "completed": "All 30 valid item ratings are present; subscales and total are derived by the server.",
    "skipped": "Assessment was not performed. No item ratings or derived scores are present, and skipped never means absent, normal, or favorable."
  },
  "legacyPassSemantics": "The v1 passed value means skipped only. V2 never uses passed as a clinical result.",
  "scoring": {
    "positive": "sum(P1..P7)",
    "negative": "sum(N1..N7)",
    "general": "sum(G1..G16)",
    "total": "positive + negative + general",
    "ranges": {
      "positive": {"minimum": 7, "maximum": 49},
      "negative": {"minimum": 7, "maximum": 49},
      "general": {"minimum": 16, "maximum": 112},
      "total": {"minimum": 30, "maximum": 210}
    },
    "clientDerivedScoresAccepted": false
  },
  "identity": {
    "assessmentId": "UUID",
    "patientId": "UUID",
    "encounterId": "UUID"
  },
  "concurrency": {
    "etag": "strong",
    "ifMatchRequiredForUpdate": true
  },
  "idempotency": {
    "header": "Idempotency-Key",
    "requiredForCreate": true,
    "sameKeySameRequest": "replay-original-response",
    "sameKeyDifferentRequest": "409 COMMON_IDEMPOTENCY_KEY_REUSED",
    "retentionSeconds": 86400
  },
  "provenance": {
    "required": ["sourceModule", "createdAt", "updatedAt", "createdRequestId", "updatedRequestId", "scaleVersion", "ruleVersion"]
  }
}

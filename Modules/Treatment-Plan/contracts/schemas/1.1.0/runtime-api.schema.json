{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.example/contracts/treatment-plan/1.1.0/runtime-api.schema.json",
  "title": "INSIGHT Treatment Plan live HTTP envelopes",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"const": "ok"}
      }
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authMode"],
      "properties": {
        "status": {"const": "ready"},
        "authMode": {"enum": ["development-stub", "rest", "disabled"]}
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "mode"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "mode": {"enum": ["development-stub", "rest"]}
      }
    },
    "PlanEditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "editId", "planId", "actorId", "sessionId",
        "editedAt", "sequence", "path", "operation", "before", "after",
        "category", "reason"
      ],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "editId": {"$ref": "#/$defs/Uuid"},
        "planId": {"$ref": "#/$defs/Uuid"},
        "actorId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1},
        "editedAt": {"type": "string", "format": "date-time"},
        "sequence": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "pattern": "^/"},
        "operation": {"enum": ["add", "replace", "remove"]},
        "before": true,
        "after": true,
        "category": {
          "enum": [
            "routine", "warning-removal", "severe-ddi-override",
            "urgent-setting-override", "policy-bound-override"
          ]
        },
        "reason": {"type": ["string", "null"]}
      }
    },
    "PlanView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryPlan", "plan", "edits", "version"],
      "properties": {
        "primaryPlan": {"type": "object"},
        "plan": {"type": "object"},
        "edits": {
          "type": "array",
          "items": {"$ref": "#/$defs/PlanEditEvent"}
        },
        "version": {"type": "integer", "minimum": 0}
      }
    },
    "EditDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path"],
      "properties": {
        "operation": {"enum": ["add", "replace", "remove"]},
        "path": {"type": "string", "pattern": "^/"},
        "after": true,
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"enum": ["add", "replace"]}},
            "required": ["operation"]
          },
          "then": {"required": ["after"]}
        }
      ]
    },
    "FinalizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation"],
      "properties": {
        "attestation": {"type": "string"}
      }
    },
    "FinalPlan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion", "planId", "primaryPlanId", "patientId",
        "encounterId", "version", "status", "finalizedAt", "finalizedBy",
        "attestation", "content", "safetyFindings", "provenance", "contentHash"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "planId": {"$ref": "#/$defs/Uuid"},
        "primaryPlanId": {"$ref": "#/$defs/Uuid"},
        "patientId": {"$ref": "#/$defs/Uuid"},
        "encounterId": {"$ref": "#/$defs/Uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"const": "finalized"},
        "finalizedAt": {"type": "string", "format": "date-time"},
        "finalizedBy": {"type": "string", "minLength": 1},
        "attestation": {"type": "string"},
        "content": {"type": "object"},
        "safetyFindings": {"type": "array"},
        "provenance": {"$ref": "#/$defs/Provenance"},
        "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion", "recordId", "recordedAt", "actorId", "action",
        "requestId", "correlationId", "sources"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "recordId": {"$ref": "#/$defs/Uuid"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "actorId": {"type": "string", "minLength": 1},
        "action": {"const": "plan.finalized"},
        "requestId": {"type": "string"},
        "correlationId": {"$ref": "#/$defs/Uuid"},
        "sources": {"type": "array"}
      }
    },
    "AuditEvent": {
      "$ref": "../1.0.0/audit-event.schema.json"
    },
    "Dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metrics", "alerts"],
      "properties": {
        "status": {"enum": ["healthy", "degraded"]},
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "labels", "value"],
            "properties": {
              "name": {"type": "string"},
              "labels": {"type": "object", "additionalProperties": {"type": "string"}},
              "value": {"type": "number"}
            }
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "name"],
            "properties": {
              "severity": {"enum": ["warning", "critical"]},
              "name": {"type": "string"}
            }
          }
        }
      }
    },
    "FastApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail"],
      "properties": {
        "detail": {
          "oneOf": [
            {"type": "string"},
            {"type": "array"}
          ]
        }
      }
    }
  }
}

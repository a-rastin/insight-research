{
  "openapi": "3.1.0",
  "info": {
    "title": "INSIGHT Treatment Plan live API",
    "version": "1.1.0",
    "description": "Contract for the routes implemented by treatment_plan.app, including authenticated recommendation runs, follow-up supersession, and the read-only advisory assistant."
  },
  "servers": [{"url": "/"}],
  "x-insight-compatibility": {
    "classification": "breaking-contract-correction",
    "supersedes": "treatment-plan.openapi.v1.0.0.json",
    "runtimeBehaviorChanged": true,
    "newClinicalBehavior": true,
    "runtimeValidationCorrections": [
      "plan_id path parameters reject non-UUID values",
      "X-Request-ID is required and UUID-formatted for finalization"
    ],
    "restoredImplementedClaims": [
      "POST /api/treatment-plan/v1/recommendation-runs",
      "GET /api/treatment-plan/v1/recommendation-runs/{run_id}",
      "POST /api/treatment-plan/v1/plans/{plan_id}/supersede"
    ]
  },
  "x-insight-provider-contracts": [
    {
      "provider": "authentication",
      "operation": "GET /api/auth/v2/session",
      "schema": "../../../Auth/docs/auth-session-v2.schema.json",
      "use": "Current server-side session, role, account, password, and disclaimer authorization"
    },
    {
      "provider": "ddi-checker",
      "operation": "POST /api/ddi/v1/checks",
      "openapi": "../../../DDI-Checker-1.2.0/contracts/openapi-v1.json",
      "use": "Finalization-time medication safety revalidation"
    },
    {
      "provider": "bn-manager",
      "operation": "POST /api/bn-manager/v3/evaluations",
      "openapi": "../../../BN-Manager-v.1.1.0/BN-Manager-v.1.1.0/contracts/openapi-v3.json",
      "implementationIssue": "INS-019",
      "use": "Registry-governed Bayesian evaluation"
    }
  ],
  "tags": [
    {"name": "operations"},
    {"name": "clinical-plans"},
    {"name": "assistant"},
    {"name": "support"}
  ],
  "paths": {
    "/api/treatment-plan/v1/contract": {
      "get": {
        "operationId": "discoverTreatmentPlanContract",
        "x-insight-implementation-issue": "INS-049",
        "tags": ["operations"],
        "security": [],
        "responses": {
          "200": {
            "description": "Treatment Plan interface and schema discovery",
            "headers": {
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"},
              "X-Request-ID": {"$ref": "#/components/headers/RequestId"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "../../../../contracts/common-rest-profile-v1.schema.json#/$defs/contractDiscovery"}
              }
            }
          }
        }
      }
    },
    "/api/treatment-plan/v1/openapi.json": {
      "get": {
        "operationId": "getTreatmentPlanOpenApi",
        "x-insight-implementation-issue": "INS-049",
        "tags": ["operations"],
        "security": [],
        "responses": {
          "200": {
            "description": "Canonical Treatment Plan OpenAPI 3.1 contract",
            "headers": {
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"},
              "X-Request-ID": {"$ref": "#/components/headers/RequestId"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"type": "object"}}}
          }
        }
      }
    },
    "/api/treatment-plan/v1/schemas/{name}/{version}": {
      "get": {
        "operationId": "getTreatmentPlanSchema",
        "x-insight-implementation-issue": "INS-049",
        "tags": ["operations"],
        "security": [],
        "parameters": [
          {"$ref": "#/components/parameters/SchemaName"},
          {"$ref": "#/components/parameters/SchemaArtifactVersion"}
        ],
        "responses": {
          "200": {
            "description": "Allowlisted Treatment Plan JSON Schema artifact",
            "headers": {
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"},
              "X-Request-ID": {"$ref": "#/components/headers/RequestId"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/schema+json": {"schema": {"type": "object"}}}
          },
          "404": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getTreatmentPlanHealth",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["operations"],
        "security": [],
        "responses": {
          "200": {
            "description": "Process is live",
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/Health"}}}
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getTreatmentPlanReadiness",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["operations"],
        "security": [],
        "responses": {
          "200": {
            "description": "Repository is reachable",
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/Readiness"}}}
          },
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/session": {
      "get": {
        "operationId": "getTreatmentPlanSession",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["clinical-plans"],
        "security": [{"cookieSession": []}],
        "responses": {
          "200": {
            "description": "Authorized Treatment Plan actor",
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/Session"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/recommendation-runs": {
      "post": {
        "operationId": "createRecommendationRun",
        "x-insight-implementation-issue": "INS-050",
        "tags": ["clinical-plans"],
        "description": "Creates one actor-scoped idempotent recommendation run. The server assembles authoritative context and fails closed on incomplete, incompatible, unsafe, or unavailable inputs.",
        "security": [{"cookieSession": [], "csrfToken": []}],
        "parameters": [
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/CreateRecommendationRunRequest"}}}
        },
        "responses": {
          "202": {
            "description": "Recommendation run accepted or exactly replayed",
            "headers": {
              "Idempotency-Key": {"$ref": "#/components/headers/IdempotencyKey"},
              "X-Schema-Version": {"$ref": "#/components/headers/RecommendationRunSchemaVersion"},
              "X-Request-ID": {"$ref": "#/components/headers/RequestId"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/RecommendationRun"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "409": {"$ref": "#/components/responses/RuntimeError"},
          "422": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/recommendation-runs/{run_id}": {
      "get": {
        "operationId": "getRecommendationRun",
        "x-insight-implementation-issue": "INS-050",
        "tags": ["clinical-plans"],
        "security": [{"cookieSession": []}],
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {
            "description": "Current persisted recommendation-run status",
            "headers": {"X-Schema-Version": {"$ref": "#/components/headers/RecommendationRunSchemaVersion"}},
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/RecommendationRun"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}": {
      "get": {
        "operationId": "getTreatmentPlan",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["clinical-plans"],
        "security": [{"cookieSession": []}],
        "parameters": [{"$ref": "#/components/parameters/PlanId"}],
        "responses": {
          "200": {
            "description": "Current review view reconstructed from the immutable primary plan and append-only edits",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"}
            },
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/PlanView"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/patients/{patient_id}/plans": {
      "get": {
        "operationId": "getPatientTreatmentPlanHistory",
        "x-insight-implementation-issue": "INS-069",
        "tags": ["clinical-plans"],
        "description": "Returns Treatment Plan-owned longitudinal plan views, immutable Final Plans, and supersession links for one canonical Patient UUID.",
        "security": [{"cookieSession": []}],
        "parameters": [{"$ref": "#/components/parameters/PatientId"}],
        "responses": {
          "200": {
            "description": "Patient-scoped Treatment Plan history",
            "headers": {"X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"}},
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/PatientPlanHistory"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/assistant/advisory": {
      "post": {
        "operationId": "requestTreatmentPlanAssistantAdvisory",
        "x-insight-implementation-issue": "INS-055",
        "tags": ["assistant"],
        "description": "Psychiatrist-only, non-persistent advisory request. The server loads the plan and sends only the identifier-omitted, scrubbed allowlisted projection to the configured provider. No tools or mutations are available.",
        "security": [{"cookieSession": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/AssistantAdvisoryRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Advisory text requiring psychiatrist review",
            "headers": {"X-Schema-Version": {"$ref": "#/components/headers/AssistantSchemaVersion"}},
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/AssistantAdvisoryResponse"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "422": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}/supersede": {
      "post": {
        "operationId": "supersedeTreatmentPlan",
        "x-insight-implementation-issue": "INS-053",
        "tags": ["clinical-plans"],
        "description": "Psychiatrist-only follow-up action. The supplied owner-produced Follow-up Delta is validated against the prior immutable Final Plan, fresh source snapshots are gathered, and one linked successor review workflow is created atomically.",
        "security": [{"cookieSession": [], "csrfToken": []}],
        "parameters": [
          {"$ref": "#/components/parameters/PlanId"},
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../schemas/1.0.0/treatment-plan.schema.json#/$defs/FollowUpDelta"}}}
        },
        "responses": {
          "201": {
            "description": "Successor Primary Plan review workflow and immutable supersession evidence",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "Idempotency-Key": {"$ref": "#/components/headers/IdempotencyKey"},
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"},
              "X-Request-ID": {"$ref": "#/components/headers/RequestId"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/SupersedePlanResponse"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "409": {"$ref": "#/components/responses/RuntimeError"},
          "422": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}/draft": {
      "patch": {
        "operationId": "editTreatmentPlanDraft",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["clinical-plans"],
        "description": "Psychiatrist-only mutation. Cookie authorization and X-CSRF-Token are validated server-side; If-Match prevents lost updates.",
        "security": [{"cookieSession": [], "csrfToken": []}],
        "parameters": [
          {"$ref": "#/components/parameters/PlanId"},
          {"$ref": "#/components/parameters/IfMatch"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/EditDraftRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Updated review view",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Schema-Version": {"$ref": "#/components/headers/PlanViewSchemaVersion"}
            },
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/PlanView"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "412": {"$ref": "#/components/responses/RuntimeError"},
          "422": {"$ref": "#/components/responses/RuntimeError"},
          "428": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}/finalize": {
      "post": {
        "operationId": "finalizeTreatmentPlan",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["clinical-plans"],
        "description": "Psychiatrist-only immutable finalization. The actor-scoped command is reauthorized and safety is revalidated server-side. Exact retries return the original result; conflicting reuse returns 409.",
        "security": [{"cookieSession": [], "csrfToken": []}],
        "parameters": [
          {"$ref": "#/components/parameters/PlanId"},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/FinalizeRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Immutable Final Treatment Plan",
            "headers": {
              "Idempotency-Key": {"$ref": "#/components/headers/IdempotencyKey"},
              "X-Schema-Version": {"$ref": "#/components/headers/FinalPlanSchemaVersion"}
            },
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/FinalPlan"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "409": {"$ref": "#/components/responses/RuntimeError"},
          "412": {"$ref": "#/components/responses/RuntimeError"},
          "422": {"$ref": "#/components/responses/RuntimeError"},
          "428": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}/provenance": {
      "get": {
        "operationId": "getTreatmentPlanProvenance",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["clinical-plans"],
        "security": [{"cookieSession": []}],
        "parameters": [{"$ref": "#/components/parameters/PlanId"}],
        "responses": {
          "200": {
            "description": "Zero or one clinical provenance record",
            "headers": {"X-Schema-Version": {"$ref": "#/components/headers/FinalPlanSchemaVersion"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 1,
                  "items": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/Provenance"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "404": {"$ref": "#/components/responses/RuntimeError"},
          "500": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/plans/{plan_id}/audit": {
      "get": {
        "operationId": "getTreatmentPlanSecurityAudit",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["support"],
        "description": "Requires explicit audit-read authorization; clinical provenance is not returned.",
        "security": [{"cookieSession": []}],
        "parameters": [{"$ref": "#/components/parameters/PlanId"}],
        "responses": {
          "200": {
            "description": "Security audit events",
            "headers": {"X-Schema-Version": {"$ref": "#/components/headers/FinalPlanSchemaVersion"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/AuditEvent"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/api/treatment-plan/v1/observability/dashboard": {
      "get": {
        "operationId": "getTreatmentPlanObservabilityDashboard",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["support"],
        "description": "Requires explicit support-read authorization.",
        "security": [{"cookieSession": []}],
        "responses": {
          "200": {
            "description": "PHI-safe operational metrics and alerts",
            "content": {"application/json": {"schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/Dashboard"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getTreatmentPlanPrometheusMetrics",
        "x-insight-implementation-issue": "INS-020",
        "tags": ["support"],
        "description": "Requires explicit support-read authorization.",
        "security": [{"cookieSession": []}],
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {"text/plain": {"schema": {"type": "string"}}}
          },
          "401": {"$ref": "#/components/responses/RuntimeError"},
          "503": {"$ref": "#/components/responses/RuntimeError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Opaque Authentication cookie; Treatment Plan revalidates it through GET /api/auth/v2/session."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "parameters": {
      "PlanId": {
        "name": "plan_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "PatientId": {
        "name": "patient_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "minLength": 1}
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "minLength": 1}
      },
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "schema": {"type": "string", "format": "uuid"}
      },
      "SchemaName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {"enum": ["audit-event", "runtime-api", "treatment-plan"]}
      },
      "SchemaArtifactVersion": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "headers": {
      "ETag": {"schema": {"type": "string", "minLength": 1}},
      "PlanViewSchemaVersion": {"schema": {"const": "1.1.0"}},
      "FinalPlanSchemaVersion": {"schema": {"const": "1.0.0"}},
      "RecommendationRunSchemaVersion": {"schema": {"const": "1.1.0"}},
      "AssistantSchemaVersion": {"schema": {"const": "1.0.0"}},
      "IdempotencyKey": {"schema": {"type": "string", "minLength": 1}},
      "RequestId": {"schema": {"type": "string", "format": "uuid"}},
      "CorrelationId": {"schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {
      "RuntimeError": {
        "description": "Current FastAPI error envelope",
        "content": {
          "application/json": {
            "schema": {"$ref": "../schemas/1.1.0/runtime-api.schema.json#/$defs/FastApiError"}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.local/schemas/governance/treatment-plan-scope-matrix/1.0.0",
  "title": "INSIGHT Treatment Plan v1 scope matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "status", "intendedUse", "clinicalScope", "knowledgeAuthority", "clinicalWorkflow", "notSupported", "decisionGates", "owners", "approvals", "regulatoryAssessment", "clinicalValidation"],
  "$defs": {
    "nullableText": {"type": ["string", "null"]},
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "populationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "behavior", "decision", "evidenceRefs"],
      "properties": {
        "category": {"enum": ["pediatrics", "pregnancy", "older-adults", "renal-impairment", "hepatic-impairment", "emergency-psychiatry"]},
        "status": {"enum": ["unresolved", "included", "excluded"]},
        "behavior": {"const": "reject_generation"},
        "decision": {"$ref": "#/$defs/nullableText"},
        "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
      }
    }
  },
  "properties": {
    "$schema": {"const": "./scope-matrix.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "documentId": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft_pending_approval", "approved", "withdrawn", "superseded"]},
    "intendedUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "researchOnly", "jurisdictions", "clinicalUser", "statement", "evidenceRefs"],
      "properties": {
        "decision": {"$ref": "#/$defs/nullableText"},
        "researchOnly": {"type": ["boolean", "null"]},
        "jurisdictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "clinicalUser": {"const": "psychiatrist"},
        "statement": {"$ref": "#/$defs/nullableText"},
        "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "clinicalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedDiagnoses", "supportedPopulation", "populationDecisions", "planBreadth", "appointmentPolicy", "emergencyBehavior"],
      "properties": {
        "supportedDiagnoses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supportedPopulation": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "populationDecisions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/populationDecision"},
          "allOf": [
            {"contains": {"properties": {"category": {"const": "pediatrics"}}, "required": ["category"]}},
            {"contains": {"properties": {"category": {"const": "pregnancy"}}, "required": ["category"]}},
            {"contains": {"properties": {"category": {"const": "older-adults"}}, "required": ["category"]}},
            {"contains": {"properties": {"category": {"const": "renal-impairment"}}, "required": ["category"]}},
            {"contains": {"properties": {"category": {"const": "hepatic-impairment"}}, "required": ["category"]}},
            {"contains": {"properties": {"category": {"const": "emergency-psychiatry"}}, "required": ["category"]}}
          ]
        },
        "planBreadth": {"$ref": "#/$defs/nullableText"},
        "appointmentPolicy": {"$ref": "#/$defs/nullableText"},
        "emergencyBehavior": {"$ref": "#/$defs/nullableText"}
      }
    },
    "knowledgeAuthority": {"type": "object"},
    "clinicalWorkflow": {"type": "object"},
    "notSupported": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case", "behavior"], "properties": {"case": {"type": "string", "minLength": 1}, "behavior": {"enum": ["reject_generation", "safety_escalation", "informational_only"]}, "rationale": {"type": "string"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}}},
    "decisionGates": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status", "decision", "decidedBy", "decidedAt", "evidenceRefs"], "properties": {"id": {"pattern": "^DG-0[1-8]$"}, "name": {"type": "string", "minLength": 1}, "status": {"enum": ["unresolved", "approved", "rejected"]}, "decision": {"$ref": "#/$defs/nullableText"}, "decidedBy": {"$ref": "#/$defs/nullableText"}, "decidedAt": {"type": ["string", "null"], "format": "date-time"}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}}},
    "owners": {"type": "object", "required": ["psychiatrist", "clinicalSafetyOfficer", "product", "privacy", "regulatory"]},
    "approvals": {"type": "array", "items": {"type": "object", "required": ["role", "name", "signedAt", "signatureRef", "scopeHash"], "properties": {"role": {"enum": ["psychiatrist", "clinicalSafetyOfficer", "product", "privacy", "regulatory"]}, "name": {"type": "string", "minLength": 1}, "signedAt": {"type": "string", "format": "date-time"}, "signatureRef": {"type": "string", "minLength": 1}, "scopeHash": {"pattern": "^sha256:[a-f0-9]{64}$"}}}},
    "regulatoryAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classification", "jurisdictionAnalysis", "assessor", "assessedAt", "evidenceRef", "reReviewTriggers"],
      "properties": {
        "status": {"enum": ["not_completed", "completed", "invalidated"]},
        "classification": {"$ref": "#/$defs/nullableText"},
        "jurisdictionAnalysis": {"$ref": "#/$defs/nullableText"},
        "assessor": {"$ref": "#/$defs/nullableText"},
        "assessedAt": {"type": ["string", "null"], "format": "date-time"},
        "evidenceRef": {"$ref": "#/$defs/nullableText"},
        "reReviewTriggers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["change", "requiredAction"], "properties": {"change": {"enum": ["intended-use", "supported-population", "diagnosis-breadth", "knowledge-sources", "deployment-jurisdiction"]}, "requiredAction": {"const": "regulatory-re-review"}}}}
      }
    },
    "clinicalValidation": {"type": "object"}
  }
}

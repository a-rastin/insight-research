<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="BIF">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="NETWORK" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="VERSION" type="xs:decimal" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="NETWORK">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NAME" type="xs:string"/>
        <xs:element ref="VARIABLE" maxOccurs="unbounded"/>
        <xs:element ref="DEFINITION" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

    <xs:key name="NodeKey">
      <xs:selector xpath="VARIABLE"/>
      <xs:field xpath="NAME"/>
    </xs:key>

    <xs:keyref name="DefFor_Matches_Node" refer="NodeKey">
      <xs:selector xpath="DEFINITION"/>
      <xs:field xpath="FOR"/>
    </xs:keyref>

    <xs:keyref name="DefGiven_Matches_Node" refer="NodeKey">
      <xs:selector xpath="DEFINITION/GIVEN"/>
      <xs:field xpath="."/>
    </xs:keyref>
  </xs:element>

  <xs:element name="VARIABLE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NAME" type="xs:string"/>
        <xs:element name="OUTCOME" type="xs:string" minOccurs="2" maxOccurs="unbounded"/>
        <xs:element name="PROPERTY" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="TYPE" type="xs:string" use="required"/> 
    </xs:complexType>
  </xs:element>

  <xs:element name="DEFINITION">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FOR" type="xs:string"/>
        <xs:element name="GIVEN" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="TABLE" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
{
  "contractId": "insight.bn-manager",
  "interfaceVersion": "3.1.0",
  "schemaVersion": "3.1.0",
  "moduleOwner": "bn-manager",
  "status": "published",
  "basePath": "/api/bn-manager/v3",
  "artifacts": [
    "bn-manager-v3.contract.json",
    "bn-manager-v3.schema.json",
    "openapi-v3.json"
  ],
  "operations": [
    {"method": "GET", "path": "/models", "operationId": "listBnModelsV3"},
    {"method": "GET", "path": "/models/{stable_id}", "operationId": "getBnModelV3"},
    {"method": "POST", "path": "/evaluations", "operationId": "createBnEvaluationV3"}
  ],
  "evaluation": {
    "registryOnly": true,
    "requestFields": ["stable_id", "candidate_id", "evidence"],
    "additionalPropertiesAllowed": false,
    "callerModelTextAllowed": false,
    "idempotencyScope": ["authenticated-actor", "key"],
    "returnsAcceptedAndIgnoredEvidence": true,
    "pharmacotherapyClinicalRecommendationUse": "research-evaluation-only-until-calibrated-and-approved"
  },
  "pharmacotherapyGovernance": {
    "mappingVersion": "2.0.0",
    "mappingPath": "governance/pharmacotherapy-mapping-v2.json",
    "calibrationStatus": "qualitative-uncalibrated",
    "candidateSemantics": "one-candidate-at-a-time-without-ranking-or-automatic-selection",
    "hardGatesPrecedePosterior": true,
    "candidateIdRequired": true,
    "completeEvidenceRequired": true,
    "returnsGateResultWithPosterior": true,
    "cptRevisionIdentity": ["semantic_version", "content_hash"],
    "cptMutationOperation": "not-published-in-v3.1.0"
  },
  "callerModelText": {
    "allowedOperation": "POST /api/bn-manager/v1/models/validate",
    "allowedRole": "admin",
    "allowedForV3Evaluation": false
  }
}

{
  "openapi": "3.1.0",
  "info": {"title": "INSIGHT BN Manager API", "version": "3.2.0"},
  "servers": [{"url": "/api/bn-manager/v3"}],
  "paths": {
    "/models": {
      "get": {
        "operationId": "listBnModelsV3",
        "responses": {
          "200": {
            "description": "Four governed registry model identities without model text",
            "content": {"application/json": {"schema": {"$ref": "bn-manager-v3.schema.json#/$defs/modelListResponse"}}}
          }
        }
      }
    },
    "/models/{stable_id}": {
      "get": {
        "operationId": "getBnModelV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "responses": {
          "200": {
            "description": "Governed registry model identity without model text",
            "content": {"application/json": {"schema": {"$ref": "bn-manager-v3.schema.json#/$defs/modelDetailResponse"}}}
          },
          "404": {"description": "Registry model not found"}
        }
      }
    },
    "/evaluations": {
      "post": {
        "operationId": "createBnEvaluationV3",
        "description": "Evaluate one registered model. Pharmacotherapy evaluates one explicit candidate, applies deterministic gates before inference, and returns an attributable posterior. Current qualitative-uncalibrated output is research-only and blocked from clinical recommendation use until a calibrated, approved CPT revision is activated with a new semantic version and content hash.",
        "security": [{"cookieSession": [], "csrfToken": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "bn-manager-v3.schema.json#/$defs/evaluationRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Traceable posterior evaluation or exact idempotent replay",
            "content": {"application/json": {"schema": {"$ref": "bn-manager-v3.schema.json#/$defs/evaluationResponse"}}}
          },
          "400": {"description": "Invalid or undeclared request fields"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Role or CSRF denied"},
          "404": {"description": "Registry model not found"},
          "409": {"description": "Idempotency key conflict"},
          "422": {"description": "Model validation or evaluation failed"}
        }
      }
    },
    "/admin/models": {
      "get": {
        "operationId": "listBnRegistryAdministrationV3",
        "description": "List manifest-owned model inventory, validation evidence, provenance, hashes, lifecycle, and activation blockers.",
        "security": [{"cookieSession": []}],
        "responses": {"200": {"description": "Admin registry inventory"}, "401": {"description": "Authentication required"}, "403": {"description": "Admin role required"}}
      }
    },
    "/admin/models/{stable_id}": {
      "get": {
        "operationId": "getBnRegistryAdministrationV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "security": [{"cookieSession": []}],
        "responses": {"200": {"description": "Admin registry model detail"}, "404": {"description": "Manifest-owned model not found"}}
      }
    },
    "/admin/models/{stable_id}/review": {
      "post": {
        "operationId": "reviewBnRegistryModelV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "security": [{"cookieSession": [], "csrfToken": []}],
        "requestBody": {"$ref": "#/components/requestBodies/LifecycleAction"},
        "responses": {"200": {"description": "Model reviewed with validation evidence"}, "409": {"description": "Lifecycle conflict"}, "422": {"description": "Validation failed"}}
      }
    },
    "/admin/models/{stable_id}/activate": {
      "post": {
        "operationId": "activateBnRegistryModelV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "security": [{"cookieSession": [], "csrfToken": []}],
        "requestBody": {"$ref": "#/components/requestBodies/LifecycleAction"},
        "responses": {"200": {"description": "Model activated"}, "409": {"description": "Lifecycle or manifest admission conflict"}}
      }
    },
    "/admin/models/{stable_id}/retire": {
      "post": {
        "operationId": "retireBnRegistryModelV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "security": [{"cookieSession": [], "csrfToken": []}],
        "requestBody": {"$ref": "#/components/requestBodies/LifecycleAction"},
        "responses": {"200": {"description": "Model retired"}, "409": {"description": "Lifecycle conflict"}}
      }
    },
    "/admin/models/{stable_id}/rollback": {
      "post": {
        "operationId": "rollbackBnRegistryModelV3",
        "parameters": [{"$ref": "#/components/parameters/StableId"}],
        "security": [{"cookieSession": [], "csrfToken": []}],
        "requestBody": {"$ref": "#/components/requestBodies/LifecycleAction"},
        "responses": {"200": {"description": "Previous governed lifecycle status restored"}, "409": {"description": "No safe rollback target"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieSession": {"type": "apiKey", "in": "cookie", "name": "session"},
      "csrfToken": {"type": "apiKey", "in": "header", "name": "X-CSRF-Token"}
    },
    "requestBodies": {
      "LifecycleAction": {
        "required": true,
        "content": {"application/json": {"schema": {"$ref": "bn-manager-v3.schema.json#/$defs/lifecycleRequest"}}}
      }
    },
    "parameters": {
      "StableId": {
        "name": "stable_id",
        "in": "path",
        "required": true,
        "schema": {"$ref": "bn-manager-v3.schema.json#/$defs/model/properties/stable_id"}
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}

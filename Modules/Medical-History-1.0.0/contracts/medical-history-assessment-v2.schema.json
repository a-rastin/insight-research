{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.local/schemas/medical-history/medical-history-assessment-v2.schema.json",
  "title": "INSIGHT Medical History Assessment v2",
  "$ref": "#/$defs/assessment",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "clinicalState": {"enum": ["yes", "no", "unknown", "not-assessed"]},
    "historyOption": {"enum": ["Diabetes mellitus", "Hypertension", "Coronary artery disease", "Heart failure", "Chronic obstructive pulmonary disease", "Asthma", "Chronic kidney disease", "Stroke or TIA", "Cancer", "Depression", "Anxiety disorder", "Other"]},
    "antipsychotic": {"enum": ["Aripiprazole", "Asenapine", "Brexpiprazole", "Cariprazine", "Chlorpromazine", "Clozapine", "Fluphenazine", "Haloperidol", "Iloperidone", "Lurasidone", "Olanzapine", "Paliperidone", "Perphenazine", "Quetiapine", "Risperidone", "Ziprasidone"]},
    "clozapineContraindicationOption": {"enum": ["Severe neutropenia", "Clozapine-induced myocarditis", "Unmanaged seizure disorder"]},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "role"],
      "properties": {
        "actorId": {"$ref": "#/$defs/uuid"},
        "role": {"const": "psychiatrist"}
      }
    },
    "normalizedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "conceptId", "display", "terminologyVersion"],
      "properties": {
        "state": {"enum": ["matched", "unresolved", "ambiguous", "not-assessed"]},
        "conceptId": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "display": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "terminologyVersion": {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "matched"}}, "required": ["state"]},
          "then": {
            "properties": {
              "conceptId": {"type": "string", "minLength": 1},
              "display": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "conceptId": {"type": "null"},
              "display": {"type": "null"},
              "terminologyVersion": {"type": "null"}
            }
          }
        }
      ]
    },
    "medication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalText", "doseText", "routeText", "frequencyText", "normalizedIdentity"],
      "properties": {
        "originalText": {"type": "string", "minLength": 1, "maxLength": 500},
        "doseText": {"type": ["string", "null"], "maxLength": 160},
        "routeText": {"type": ["string", "null"], "maxLength": 160},
        "frequencyText": {"type": ["string", "null"], "maxLength": 160},
        "normalizedIdentity": {"$ref": "#/$defs/normalizedIdentity"}
      }
    },
    "writeFields": {
      "type": "object",
      "required": ["status", "pastMedicalHistory", "medications", "substantialSuicideRisk", "priorAntipsychoticTherapy", "priorAntipsychoticTherapySuccessful", "antipsychotic", "clozapineContraindication", "clozapineContraindications", "recurrentNonAdherenceDeterioration", "actor"],
      "properties": {
        "status": {"enum": ["in-progress", "completed", "not-assessed"]},
        "pastMedicalHistory": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/historyOption"}},
        "medications": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/medication"}},
        "substantialSuicideRisk": {"$ref": "#/$defs/clinicalState"},
        "priorAntipsychoticTherapy": {"$ref": "#/$defs/clinicalState"},
        "priorAntipsychoticTherapySuccessful": {"$ref": "#/$defs/clinicalState"},
        "antipsychotic": {"oneOf": [{"$ref": "#/$defs/antipsychotic"}, {"type": "null"}]},
        "clozapineContraindication": {"$ref": "#/$defs/clinicalState"},
        "clozapineContraindications": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/clozapineContraindicationOption"}},
        "recurrentNonAdherenceDeterioration": {"$ref": "#/$defs/clinicalState"},
        "actor": {"$ref": "#/$defs/actor"}
      },
      "allOf": [
        {
          "if": {"properties": {"priorAntipsychoticTherapy": {"const": "yes"}}, "required": ["priorAntipsychoticTherapy"]},
          "then": {"properties": {"antipsychotic": {"$ref": "#/$defs/antipsychotic"}}},
          "else": {"properties": {"antipsychotic": {"type": "null"}, "priorAntipsychoticTherapySuccessful": {"const": "not-assessed"}}}
        },
        {
          "if": {"properties": {"clozapineContraindication": {"const": "yes"}}, "required": ["clozapineContraindication"]},
          "then": {"properties": {"clozapineContraindications": {"minItems": 1}}},
          "else": {"properties": {"clozapineContraindications": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "not-assessed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "pastMedicalHistory": {"maxItems": 0},
              "medications": {"maxItems": 0},
              "substantialSuicideRisk": {"const": "not-assessed"},
              "priorAntipsychoticTherapy": {"const": "not-assessed"},
              "priorAntipsychoticTherapySuccessful": {"const": "not-assessed"},
              "antipsychotic": {"type": "null"},
              "clozapineContraindication": {"const": "not-assessed"},
              "clozapineContraindications": {"maxItems": 0},
              "recurrentNonAdherenceDeterioration": {"const": "not-assessed"}
            }
          }
        }
      ]
    },
    "assessmentWrite": {
      "allOf": [
        {"$ref": "#/$defs/writeFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["patientId", "encounterId"],
          "properties": {
            "patientId": {"$ref": "#/$defs/uuid"},
            "encounterId": {"$ref": "#/$defs/uuid"},
            "status": true,
            "pastMedicalHistory": true,
            "medications": true,
            "substantialSuicideRisk": true,
            "priorAntipsychoticTherapy": true,
            "priorAntipsychoticTherapySuccessful": true,
            "antipsychotic": true,
            "clozapineContraindication": true,
            "clozapineContraindications": true,
            "recurrentNonAdherenceDeterioration": true,
            "actor": true
          }
        }
      ]
    },
    "assessmentUpdate": {
      "allOf": [
        {"$ref": "#/$defs/writeFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": true,
            "pastMedicalHistory": true,
            "medications": true,
            "substantialSuicideRisk": true,
            "priorAntipsychoticTherapy": true,
            "priorAntipsychoticTherapySuccessful": true,
            "antipsychotic": true,
            "clozapineContraindication": true,
            "clozapineContraindications": true,
            "recurrentNonAdherenceDeterioration": true,
            "actor": true
          }
        }
      ]
    },
    "assessment": {
      "allOf": [
        {"$ref": "#/$defs/writeFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["interfaceVersion", "schemaVersion", "assessmentId", "patientId", "encounterId", "createdAt", "updatedAt", "resourceVersion", "provenance"],
          "properties": {
            "interfaceVersion": {"const": "2.0.0"},
            "schemaVersion": {"const": "2.0.0"},
            "assessmentId": {"$ref": "#/$defs/uuid"},
            "patientId": {"$ref": "#/$defs/uuid"},
            "encounterId": {"$ref": "#/$defs/uuid"},
            "status": true,
            "pastMedicalHistory": true,
            "medications": true,
            "substantialSuicideRisk": true,
            "priorAntipsychoticTherapy": true,
            "priorAntipsychoticTherapySuccessful": true,
            "antipsychotic": true,
            "clozapineContraindication": true,
            "clozapineContraindications": true,
            "recurrentNonAdherenceDeterioration": true,
            "actor": true,
            "createdAt": {"$ref": "#/$defs/utcTimestamp"},
            "updatedAt": {"$ref": "#/$defs/utcTimestamp"},
            "resourceVersion": {"type": "integer", "minimum": 1},
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceModule", "optionSetVersion", "createdRequestId", "updatedRequestId"],
              "properties": {
                "sourceModule": {"const": "medical-history"},
                "optionSetVersion": {"const": "2.0.0"},
                "createdRequestId": {"$ref": "#/$defs/uuid"},
                "updatedRequestId": {"$ref": "#/$defs/uuid"}
              }
            }
          }
        }
      ]
    }
  }
}
